POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=phoenix_feed
DATABASE_URL=postgres://phoenix:change-me-long-random-password@db:5432/phoenix_feed?sslmode=disable
ADMIN_TOKEN=change-me-admin-token
# Use :80 until DNS points at the droplet. After DNS, set a hostname such as
# feed.example.com for automatic ACME HTTPS, or ":443 tls internal" for staging.
DOMAIN=:80
ADMIN_EMAIL=owner@example.com
LOG_LEVEL=info
ALLOWED_ORIGINS=
KEY_TIER=paid
KEY_LABEL=cactus-alert-owner
OWNER_EMAIL=owner@example.com
